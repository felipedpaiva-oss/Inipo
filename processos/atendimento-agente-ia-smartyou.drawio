ght="46" as="geometry"/></mxCell><mxCell id="p1-c28" value="Lucas" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="p1-c23"><mxGeometry x="20" y="298" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c29" value="Daniel" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="p1-c23"><mxGeometry x="20" y="360" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c30" value="Atendente humano" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="p1-c23"><mxGeometry x="20" y="422" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c31" value="Não usa" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#eeeeee;strokeColor=#999999;fontColor=#777777;dashed=1;" vertex="1" parent="p1-c23"><mxGeometry x="20" y="484" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c32" value="Conferir data, hora e se hoje é feriado" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;expand=0;collapsible=0;taskMarker=businessRule;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="193" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-c33" value="Fonte de conhecimento:&lt;br&gt;&lt;b&gt;Calendário de feriados&lt;/b&gt;" style="shape=datastore;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="320" width="70" height="60" as="geometry"/></mxCell><mxCell id="p1-e34" value="" style="endArrow=none;dashed=1;dashPattern=2 3;html=1;strokeColor=#999999;endArrow=open;endFill=0;ex