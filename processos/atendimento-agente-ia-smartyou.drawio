="80" as="geometry"/></mxCell></UserObject><UserObject id="p1-c39" label="Atendimento fora do horário&lt;br&gt;&lt;i&gt;(clique para abrir a pág. 3)&lt;/i&gt;" link="data:page/id,p3"><mxCell style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;expand=0;collapsible=0;bpmnShapeType=call;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="190" width="200" height="80" as="geometry"/></mxCell></UserObject><mxCell id="p1-e40" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-c35" target="p1-c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e41" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-c35" target="p1-c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-c42" value="&lt;b&gt;Configuração do Agente IA Genérico&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Diretriz geral:&lt;/b&gt; antes de iniciar qualquer atendimento, conferir se hoje é feriado. Feriado = fora do horário: só o agente atende.&lt;br&gt;• &lt;b&gt;Fonte de conhecimento específica:&lt;/b&gt; calendário de feriados (nacionais, estaduais e municipais), a manter atualizado." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="440" width="510" height="100" as="geometry"/></mxCell><mxCell id="p1-c43" value="Daqui em diante o documento detalha &lt;b&gt;apenas o Agente IA Genérico&lt;/b&gt;. Os demais atendentes só aparecem neste mapa." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="560" width="510" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. IA Genérico – Horário comercial"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2-c1" value="&lt;b&gt;Agente IA Genérico · Em horário comercial (seg–sex, 9h–18h)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1960" height="36" as="geometry"/></mxCell><mxCell id="p2-lane-lead" value="Lead" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1960" height="170" as="geometry"/></mxCell><mxCell id="p2-lane-agente" value="Agente IA Genérico" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1960" height="430" as="geometry"/></mxCell><mxCell id="p2-lane-crm" value="CRM / Funis" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1960" height="140" as="geometry"/></mxCell><mxCell id="p2-lane-humano" value="Atendente humano" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#d5e8d4;