" vertex="1" parent="p1-c11"><mxGeometry x="20" y="112" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c14" value="WhatsApp Lite&lt;br&gt;+55 31 9455-9999" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p1-c11"><mxGeometry x="20" y="174" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c15" value="WhatsApp Business&lt;br&gt;(4 números, nenhum em uso)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#eeeeee;strokeColor=#999999;fontColor=#777777;dashed=1;" vertex="1" parent="p1-c11"><mxGeometry x="20" y="236" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c16" value="WhatsApp pessoal do Lucas?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="p1-c11"><mxGeometry x="20" y="298" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c17" value="WhatsApp pessoal do Daniel?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="p1-c11"><mxGeometry x="20" y="360" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c18" value="Formulário no site ⚠ bug" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;" vertex="1" parent="p1-c11"><mxGeometry x="20" y="422" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c19" value='Botão "Entre em contato e peça um orçamento! / Falar com atendente" ⚠ bug' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;" vertex="1" parent="p1-c11"><mxGeometry x="20" y="484" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c20" value="Chatbot do site" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffffff;strokeColor=#6c8