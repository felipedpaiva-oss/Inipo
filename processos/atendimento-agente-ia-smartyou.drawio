 style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-c33" target="p3-c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e68" value="Instagram /&lt;br&gt;Facebook" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-c33" target="p3-c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-c32" target="p3-c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-c34" target="p3-c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-c35" target="p3-c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-c36" target="p3-c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-c73" value="&lt;b&gt;Critérios de qualificação&lt;/b&gt; (o agente identifica durante a conversa)&lt;br&gt;• Tipo: obra nova, reforma ou casa pronta&lt;br&gt;• Bairro / cidade&lt;br&gt;• Ambientes&lt;br&gt;• Soluções desejadas&lt;br&gt;• Prioridade: conforto, segurança, praticidade ou entretenimento&lt;br&gt;• Estágio da obra e prazo" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="470" height="140" as="geometry"/></mxCell><mxCell id="p3-c74" value='&lt;b&gt;⚠ Em aberto (fora do horário)&lt;/b&gt;&lt;br&gt;1. Quem trabalha a fila "Aguardando humano" às 9h? Em que ordem (chegada, score)?&lt;br&gt;2. Templates: textos e categoria (utilidade × marketing) a aprovar na Meta antes de ir para produção.&lt;br&gt;&lt;br&gt;&lt;i&gt;Definido: se o lead não responder ao template ou à mensagem com a tag, quem decide o que fazer é o comercial (Processo Comercial, fora deste documento). Feriados: ver configuração do agente na pág. 1.&lt;/i&gt;' style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="1220" width="560" height="170" as="geometry"/></mxCell><mxCell id="p3-c75" value="&lt;b&gt;Por que o ponto B se divide por canal&lt;/b&gt;&lt;br&gt;• &lt;b&gt;WhatsApp&lt;/b&gt;: a janela de atendimento de 24h abre e &lt;i&gt;reinicia só quando o lead escreve&lt;/i&gt;. Fora dela, só é permitido enviar template aprovado.&lt;br&gt;• &lt;b&gt;Instagram/Facebook&lt;/b&gt;: a tag HUMAN_AGENT permite que um &lt;i&gt;humano&lt;/i&gt; responda até 7 dias depois. Não pode ser usada em mensagem automática e exige permissão aprovada no app da Meta.&lt;br&gt;&lt;i&gt;Fonte: Meta for Developers — WhatsApp Business Platform, &amp;quot;Customer service windows&amp;quot; e Messenger/Instagram Platform, &amp;quot;Human Agent tag&amp;quot;.&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="1220" width="760" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Subprocesso – Inatividade"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4-c1" value="&lt;b&gt;Subprocesso · Regras de inatividade (chamado pelas págs. 2 e 3)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1300" height="36" as="geometry"/></mxCell><mxCell id="p4-lane-agente" value="Agente IA Genérico" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1300" height="470" as="geometry"/></mxCell><mxCell id="p4-lane-crm" value="CRM / Funis" style="swimlane;horizontal=0;html=1;startSize=36;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1300" height="140" as="geometry"/></mxCell><mxCell id="p4-c2" value="Lead parou&lt;br&gt;de responder" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;whiteSpace=wrap;labelBackgroundColor=none;perimeter=ellipsePerimeter;outline