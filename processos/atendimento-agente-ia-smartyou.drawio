"1" parent="1" source="p4-c8" target="p4-c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.75;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-c4" target="p4-c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-c10" target="p4-c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-c4" target="p4-c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-c12" target="p4-c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e27" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-c13" target="p4-c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e28" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-c13" target="p4-c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e29" value="volta a aguardar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-c9" target="p4-c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="270"/><mxPoint x="840" y="115"/><mxPoint x="215" y="115"/></Array></mxGeometry></mxCell><mxCell id="p4-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-c11" target="p4-c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="380"/><mxPoint x="840" y="115"/><mxPoint x="215" y="115"/></Array></mxGeometry></mxCell><mxCell id="p4-e31" value="Sim (só aguarda)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-c8" target="p4-c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="515" y="210"/><mxPoint x="840" y="210"/><mxPoint x="840" y="115"/><mxPoint x="215" y="115"/></Array></mxGeometry></mxCell><mxCell id="p4-c32" value='&lt;b&gt;Regras&lt;/b&gt;&lt;br&gt;• 15 min sem resposta → reativação. Limite por período de silêncio: &lt;b&gt;2&lt;/b&gt; em horário comercial, &lt;b&gt;1&lt;/b&gt; fora do horário.&lt;br&gt;• 23h → última reativação. Os relógios de 23h/24h contam a partir da &lt;b&gt;última mensagem do lead&lt;/b&gt;, não da última mensagem do agente: a janela de 24h da Meta só reinicia quando o usuário escreve. Uma reativação enviada pelo agente não estende o prazo.&lt;br&gt;• 24h → perdido, &lt;i&gt;exceto&lt;/i&gt; se o lead estiver na fila "Aguardando humano" (pedido feito fora do horário).&lt;br&gt;&lt;i&gt;Fonte: Meta for Developers — WhatsApp Business Platform, &amp;quot;Customer service windows&amp;quot; e Messenger/Instagram Platform, &amp;quot;Human Agent tag&amp;quot;.&lt;/i&gt;' style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="110" width="450" height="230" as="geometry"/></mxCell><mxCell id="p4-c33" value="&lt;b&gt;⚠ Em aberto&lt;/b&gt;&lt;br&gt;1. A reativação única vale para todo o período fora do horário (ex.: sábado às 14h) ou só para a madrugada? Se for só madrugada, qual faixa (ex.: 22h–7h)?&lt;br&gt;2. Textos das mensagens de reativação.&lt;br&gt;3. No Instagram/Facebook a janela padrão também é de 24h: a regra vale igual em todos os canais?" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="360" width="450" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="Leia-me · Legenda"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5-c1" value="&lt;b&gt;Leia-me · Notação usada (BPMN 2.0 simplificado)&lt;/b&gt;" style="text;html=1;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="34" as="geometry"/></mxCell><mxCell id="p5-c2" value="Evento de início (mensagem do lead)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;whiteSpace=wrap;labelBackgroundColor=none;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=message;fillColor=#ffffff;strokeWidth=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="40" height="40" as="geometry"/></mxCell><mxCell id="p5-c3" value="Evento de fim (passa para outro processo)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;whiteSpace=wrap;labelBackgroundColor=none;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#ffffff;strokeWidth=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="138" width="40" height="40" as="geometry"/></mxCell><mxCell id="p5-c4" value="Fim em funil do CRM (perdido / desqualificado)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;whiteSpace=wrap;labelBackgroundColor=none;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=terminate;fillColor=#ffffff;strokeWidth=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="40" height="40" as="geometry"/></mxCell><mxCell id="p5-c5" value="Espera por tempo (timer)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;whiteSpace=wrap;labelBackgroundColor=none;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=catching;symbol=timer;fillColor=#ffffff;strokeWidth=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="254" width="40" height="40" as="geometry"/></mxCell><mxCell id="p5-c6" value="Evento de borda que interrompe a atividade" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;whiteSpace=wrap;labelBackgroundColor=none;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundInt;symbol=message;fillColor=#ffffff;strokeWidth=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="312" width="40" height="40" as="geometry"/></mxCell><mxCell id="p5-c7" value="Evento de borda que não interrompe (tracejado)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;whiteSpace=wrap;labelBackgroundColor=none;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=boundNonint;symbol=timer;fillColor=#ffffff;strokeWidth=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="40" height="40" as="geometry"/></mxCell><mxCell id="p5-c8" value='Link de saída / entrada ("Vai para A"): evita linhas cruzadas' style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;whiteSpace=wrap;labelBackgroundColor=none;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=throwing;symbol=link;fillColor=#ffffff;strokeWidth=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="428" width="40" height="40" as="geometry"/></mxCell><mxCell id="p5-c9" value="Decisão exclusiva (só um caminho)" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;whiteSpace=wrap;labelBackgroundColor=none;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=exclusiveGw;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="50" height="50" as="geometry"/></mxCell><mxCell id="p5-c10" value="Paralelo (os caminhos acontecem ao mesmo tempo)" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;whiteSpace=wrap;labelBackgroundColor=none;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=parallelGw;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="554" width="50" height="50" as="geometry"/></mxCell><mxCell id="p5-c11" value="Baseado em evento (segue o que acontecer primeiro)" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;whiteSpace=wrap;labelBackgroundColor=none;perimeter=rhombusPerimeter;outlineConnect=0;outline=catching;symbol=multiple;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="622" width="50" height="50" as="geometry"/></mxCell><mxCell id="p5-c12" value="Tarefa automática do agente" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="180" height="60" as="geometry"/></mxCell><mxCell id="p5-c13" value="Envio de mensagem / notificação" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;expand=0;collapsible=0;taskMarker=send;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="180" height="60" as="geometry"/></mxCell><mxCell id="p5-c14" value="Tarefa humana" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;expand=0;collapsible=0;taskMarker=user;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="240" width="180" height="60" as="geometry"/></mxCell><mxCell id="p5-c15" value="Subprocesso (clique para abrir a página)" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;expand=0;collapsible=0;bpmnShapeType=call;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="180" height="60" as="geometry"/></mxCell><mxCell id="p5-c16" value="Pendência / decisão em aberto" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="180" height="50" as="geometry"/></mxCell><mxCell id="p5-c17" value="&lt;b&gt;Raias:&lt;/b&gt; Lead · Agente IA Genérico · CRM/Funis · Atendente humano. Cada raia mostra &lt;i&gt;quem&lt;/i&gt; executa o passo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Exportar para Visio:&lt;/b&gt; no draw.io, Arquivo → Exportar como → VSDX.&lt;br&gt;&lt;b&gt;Editar:&lt;/b&gt; app.diagrams.net → Abrir de → Dispositivo (ou GitHub)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="420" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
