<mxfile host="app.diagrams.net" agent="gerar_processo.py" version="24.7.17"><diagram id="p1" name="1. Fontes → Canais → Atendentes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-c1" value="&lt;b&gt;SmartYou · Atendimento de leads: fontes → canais → atendentes&lt;/b&gt;" style="text;html=1;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell><mxCell id="p1-c2" value='&lt;b&gt;Como associar:&lt;/b&gt; passe o mouse sobre uma caixa, arraste uma das setas azuis até a caixa de destino e solte. Para apagar uma associação, clique na linha e tecle Delete. Cada coluna é um contêiner: arraste o título para mover a coluna inteira.&lt;br&gt;&lt;b&gt;Legenda:&lt;/b&gt; borda tracejada = a confirmar ("?") · borda vermelha = com bug · cinza = não utilizado.' style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1120" height="70" as="geometry"/></mxCell><mxCell id="p1-c3" value="FONTES DE LEADS" style="swimlane;html=1;startSize=40;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#fbfbfb;fontStyle=1;fontSize=13;rounded=1;arcSize=4;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="300" height="494" as="geometry"/></mxCell><mxCell id="p1-c4" value="Facebook Ads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="p1-c3"><mxGeometry x="20" y="50" width="260" height="46" as="geometry"/></mxCell><mxCell id="p1-c5" value="Instagram Ads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="p1-c3"><mxGeometry x="20"